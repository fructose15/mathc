#!/bin/sh
# MathC Build Configuration Script
# Generates a Makefile for Linux, macOS, and Android (Termux).

set -e

PREFIX="/usr/local"
CC=""
CFLAGS="-O2 -Wall -Wextra -std=c99"
LDFLAGS="-lm"
OS_RAW="$(uname -s 2>/dev/null || echo Unknown)"
ARCH_RAW="$(uname -m 2>/dev/null || echo unknown)"

for arg in "$@"; do
  case "$arg" in
    --prefix=*)
      PREFIX="${arg#*=}"
      ;;
    --cc=*)
      CC="${arg#*=}"
      ;;
    --help|-h)
      echo "MathC configure script"
      echo "Usage: ./configure [--prefix=/usr/local] [--cc=gcc|clang]"
      exit 0
      ;;
    *)
      echo "Unknown option: $arg" >&2
      exit 1
      ;;
  esac
done

# Detect platform
PLATFORM="linux"
case "$OS_RAW" in
  Linux)
    if [ -n "$TERMUX_VERSION" ] || [ -d "/data/data/com.termux" ]; then
      PLATFORM="android"
      if [ "$PREFIX" = "/usr/local" ]; then
        PREFIX="/data/data/com.termux/files/usr"
      fi
    else
      PLATFORM="linux"
    fi
    ;;
  Darwin)
    PLATFORM="macos"
    ;;
  *)
    PLATFORM="unix"
    ;;
esac

# Detect C compiler
if [ -z "$CC" ]; then
  if command -v gcc >/dev/null 2>&1; then
    CC="gcc"
  elif command -v clang >/dev/null 2>&1; then
    CC="clang"
  elif command -v cc >/dev/null 2>&1; then
    CC="cc"
  else
    echo "Error: No C compiler (gcc, clang, or cc) found in PATH." >&2
    exit 1
  fi
fi

BINDIR="${PREFIX}/bin"

echo "Configuring MathC 1.0.0..."
echo "  Platform : ${PLATFORM} (${OS_RAW} ${ARCH_RAW})"
echo "  Compiler : ${CC}"
echo "  Prefix   : ${PREFIX}"
echo "  Binary   : ${BINDIR}/mcc"

sed \
  -e "s|@CC@|${CC}|g" \
  -e "s|@CFLAGS@|${CFLAGS}|g" \
  -e "s|@LDFLAGS@|${LDFLAGS}|g" \
  -e "s|@PREFIX@|${PREFIX}|g" \
  -e "s|@BINDIR@|${BINDIR}|g" \
  -e "s|@PLATFORM@|${PLATFORM}|g" \
  Makefile.in > Makefile

echo "Generated Makefile successfully."
echo "Next steps:"
echo "  make"
echo "  sudo make install   (installs to ${BINDIR}/mcc)"
